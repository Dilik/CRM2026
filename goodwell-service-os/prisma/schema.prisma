generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  MASTER
  WAREHOUSE
  EXECUTIVE
}

enum LocaleCode {
  uz_Latn
  uz_Cyrl
  ru
  en
}

model User {
  id            String     @id @default(cuid())
  phone         String     @unique
  phoneVerified Boolean    @default(false)
  name          String
  role          UserRole
  language      LocaleCode @default(uz_Latn)
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model OtpRateLimit {
  id        String   @id @default(cuid())
  phone     String
  windowKey String
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([phone, windowKey])
  @@index([phone])
  @@index([expiresAt])
}
